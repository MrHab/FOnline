* text=auto

*.css text eol=lf
*.cs text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.nvmrc text eol=lf

# Reviewed manifests/reports are SHA-256 evidence. Preserve the approved bytes
# across Windows/Linux checkouts; normalizing newlines invalidates their seals.
docs/art/reviews/**/*.json -text
public/assets/models/**/manifest.json -text
public/assets/models/**/attachment-report.json -text

*.avif binary
*.gif binary
*.glb binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
