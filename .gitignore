node_modules/

# Local runtime data. The server creates these files when needed. Authored
# world, encounter, quest, trader and loot JSON files remain versioned.
data/users.json
data/saves.json
data/wasteland-sim.json
data/*.json.tmp
data/*.corrupt-*
wasteland-sim.json
backups/

# Agent scratch space. Nested worktrees and audit dumps of runtime
# simulation state must never enter the repository.
.agents/
.codex-npc-caps-inventory/

# Local environment and logs.
.env
.env.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor noise.
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
__pycache__/
*.py[cod]

# Личные настройки и локальное состояние Claude Code; конфигурация запуска общая.
.claude/settings.local.json
.claude/worktrees/

# Unity-клиент: генерируемое состояние редактора. Library весит больше гигабайта
# и полностью восстанавливается из Assets, Packages и ProjectSettings.
# Пути ограничены unity-client/, чтобы не задеть logs/ игрового сервера.
unity-client/Library/
unity-client/Temp/
unity-client/Logs/
unity-client/UserSettings/
unity-client/Obj/
unity-client/Build/
unity-client/Builds/
unity-client/MemoryCaptures/
unity-client/*.csproj
unity-client/*.sln

# Сборка вспомогательных .NET-утилит (Tools/). Сами исходники нужны:
# правило выше ограничено корнем unity-client/ и их csproj не задевает.
unity-client/Tools/*/bin/
unity-client/Tools/*/obj/

# Локальная конфигурация MCP (пути конкретной машины).
.mcp.json

# Unity WebGL-сборка кладётся сюда при деплое, в репозиторий не входит.
public/unity/

# Облегчённые копии GLB (npm run build:models-lite), генерируются при деплое.
public/assets/models-lite/
